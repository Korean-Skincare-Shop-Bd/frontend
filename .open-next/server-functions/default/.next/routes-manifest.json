      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/products/category/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/products/[slug]",
      "regex": "^/products/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/products/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
